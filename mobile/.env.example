# Copy to .env and fill in. All EXPO_PUBLIC_* vars are embedded in the app bundle
# at build time and readable via process.env.* at runtime.

# Base URL of the kapur-home API, including the /v1 prefix.
# Local dev against `cd server && npm run dev`: use your machine's LAN IP so a
# physical device / simulator can reach it (NOT localhost).
EXPO_PUBLIC_API_URI=http://192.168.1.x:3000/v1

# AWS Cognito user pool the server verifies tokens against.
# Same values the web client uses for VITE_COGNITO_USER_POOL_ID / _APP_CLIENT_ID.
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_APP_CLIENT_ID=
